  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": [
      "eslint ./src/* --max-warnings=0",
      "prettier --write --config ./.prettierrc"
    ]
  },
  "scripts": {
    "start": "concurrently \"react-scripts start\"  \"node --loader ts-node/esm --watch ./src/api/index.js\"",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint-staged": "lint-staged"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "react-hooks/exhaustive-deps": "off"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "husky": "^9.1.7"
  }
